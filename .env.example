# Shared local configuration examples. Copy to .env locally; never commit populated .env.
APP_ENV=development
APP_NAME=RuangKampus API
API_V1_PREFIX=/api/v1

# Use a dedicated local/development PostgreSQL database, not production.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/ruangkampus_dev
POSTGRES_DB=ruangkampus_dev
POSTGRES_USER=ruangkampus
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
API_PORT=8000
WEB_CONCURRENCY=1

# Generate a private cryptographically-random value (32+ bytes) locally.
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30

# Exact trusted frontend origins, comma separated.
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local development only. Console mailbox is not actual email delivery.
EMAIL_BACKEND=console
LOCAL_MAILBOX_DIR=.local_mailbox
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

CAMPUS_TIMEZONE=Asia/Jakarta

# Frontend may use this Vite variable; Account B owns its client configuration.
VITE_API_BASE_URL=http://localhost:8000/api/v1
