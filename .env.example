# Local development defaults only. Replace placeholders in your private .env file.
APP_ENV=development
APP_NAME=RuangKampus API
API_V1_PREFIX=/api/v1

# Use a dedicated local/development PostgreSQL database. Never commit a populated .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Generate a strong private value locally; this example is not a production secret.
JWT_SIGNING_KEY=replace-with-a-long-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated trusted frontend origins.
CORS_ORIGINS=http://localhost:5173

# Optional SMTP configuration; leave blank until a provider is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Frontend configuration (Vite convention).
VITE_API_BASE_URL=http://localhost:8000/api/v1
