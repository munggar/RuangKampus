# Root Docker Compose configuration — LOCAL DEVELOPMENT ONLY.
# Copy this file to .env. Never put production secrets in this file.

APP_ENV=development
APP_NAME=RuangKampus API
API_V1_PREFIX=/api/v1

# Docker Compose overrides DATABASE_URL to the local postgres service.
DATABASE_URL=postgresql+psycopg://ruangkampus:change_me_local_only@db:5432/ruangkampus_dev
POSTGRES_DB=ruangkampus_dev
POSTGRES_USER=ruangkampus
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173
WEB_CONCURRENCY=1

# Generate a random local key of at least 32 bytes before starting the app.
JWT_SECRET_KEY=replace-with-a-long-random-local-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
CAMPUS_TIMEZONE=Asia/Jakarta

# Local development writes messages to the console/mailbox; this is not email delivery.
EMAIL_BACKEND=console
LOCAL_MAILBOX_DIR=.local_mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Optional Brevo setup for a separately configured environment. Do not use production keys locally.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RuangKampus

# Uploaded room photos. Docker Compose maps this to the local .room-media folder.
ROOM_MEDIA_DIR=/data/room-media

# Optional RUKKA language layer. Without a provider key, deterministic database-grounded responses remain available.
ASSISTANT_AI_ENABLED=true
ASSISTANT_AI_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
ASSISTANT_AI_MODEL=google/gemma-4-26b-a4b-it:free
ASSISTANT_AI_TIMEOUT_SECONDS=8
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Public API base URL is embedded into frontend assets at build time.
VITE_API_BASE_URL=http://localhost:8000/api/v1
