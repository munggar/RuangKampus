# Copy to backend/.env for local development. Never commit the populated .env.
APP_ENV=development
APP_NAME=RuangKampus API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE_NAME
# Local-only fallback for an isolated SQLite database:
# DATABASE_URL=sqlite:///./ruangkampus_local.db

# Replace locally with a cryptographically random value (at least 32 bytes).
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes-for-local-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local development writes reset email messages to a gitignored mailbox directory.
EMAIL_BACKEND=console
LOCAL_MAILBOX_DIR=.local_mailbox
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Optional production transactional email provider. Leave EMAIL_BACKEND=console locally.
# In Railway, use EMAIL_BACKEND=brevo with a Brevo API key and a verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Backward-compatible alias if already configured in Railway:
# BREVO_SENDER_MAIL=
BREVO_SENDER_NAME=RuangKampus

# Operational timezone for campus dates/times.
CAMPUS_TIMEZONE=Asia/Jakarta

# Persistent directory for room photos extracted from Excel. Mount a Railway volume at /data.
ROOM_MEDIA_DIR=/data/room-media

# Optional conversational AI fallback. Disabled by default.
# Configure an OpenAI-compatible chat-completions endpoint (hosted or self-hosted).
# The provider receives only the current message and an allowlisted room-data vocabulary,
# never the user's ID, conversation state, reservation history, or full chat history.
ASSISTANT_AI_ENABLED=false
ASSISTANT_AI_ENDPOINT_URL=
ASSISTANT_AI_MODEL=
ASSISTANT_AI_API_KEY=
ASSISTANT_AI_TIMEOUT_SECONDS=4
